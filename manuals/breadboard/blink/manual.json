{
  "board": "uno",
  "parts": [
    { "id": "led1", "partType": "bb:led_red", "pins": [ { "row": "e", "col": 22 }, { "row": "e", "col": 23 } ], "polarity": ["anode", "cathode"] },
    { "id": "r1", "partType": "bb:resistor_220", "pins": [ { "row": "d", "col": 23 }, { "row": "gnd", "col": 23 } ] }
  ],
  "wires": [
    { "id": "w1", "from": { "board": "GND" }, "to": { "row": "gnd", "col": 1 }, "color": "black" },
    { "id": "w2", "from": { "board": "D9" }, "to": { "row": "a", "col": 22 }, "color": "yellow" }
  ],
  "steps": [
    { "title": "Ground rail", "add": ["w1"], "text": "Connect the board's GND to the breadboard's ground rail." },
    { "title": "LED", "add": ["led1"], "text": "Seat the red LED in e22 (long leg) and e23 (short leg)." },
    { "title": "Resistor", "add": ["r1"], "text": "Run the 220Ω resistor from d23 to the ground rail." },
    { "title": "Signal", "add": ["w2"], "text": "Wire D9 to a22.",
      "probes": [ { "pin": "D9", "mode": "pulse", "expect": { "value": 1 }, "note": "LED should blink" } ] }
  ],
  "sketch": "blink.ino"
}
