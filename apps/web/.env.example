# Configure one or more providers (AI Gateway is preferred when present). See PRD §16.
AI_GATEWAY_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Vision model prefix selects a direct provider; unset picks Google first, then Anthropic.
VISION_MODEL=google/gemini-3.6-flash
# LEGO part ids and colours come from Brickognize (public, keyless); the vision model only localizes pieces.
# Set BRICKOGNIZE=0 to let the vision model classify LEGO too. BRICKOGNIZE_URL overrides the API host.
BRICKOGNIZE=1
# Breadboard parts: each vision-model crop is re-classified zero-shot by CLIP on the Hugging Face
# Inference API when HF_TOKEN is set. PART_CLASSIFIER=0 disables it; PART_CLASSIFIER_MODEL overrides the model.
HF_TOKEN=
PART_CLASSIFIER=1
PART_CLASSIFIER_MODEL=openai/clip-vit-large-patch14
# Dropbox App Folder integration (Phase A).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT=
DROPBOX_COOKIE_SECRET=
# Stream hub (services/stream-hub). Use the laptop's LAN IP so phones can reach it.
NEXT_PUBLIC_HUB_WS=ws://localhost:8787
