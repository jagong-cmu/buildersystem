# One of the two (AI Gateway preferred). See PRD §16.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# Vision model as a gateway string; the direct provider strips the "anthropic/" prefix.
VISION_MODEL=anthropic/claude-sonnet-5
# Dropbox App Folder integration (Phase A).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT=
DROPBOX_COOKIE_SECRET=
# Stream hub (services/stream-hub). Use the laptop's LAN IP so phones can reach it.
NEXT_PUBLIC_HUB_WS=ws://localhost:8787
