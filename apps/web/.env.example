# Configure one or more providers (AI Gateway is preferred when present). See PRD §16.
AI_GATEWAY_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Vision model prefix selects a direct provider; unset picks Google first, then Anthropic.
VISION_MODEL=google/gemini-3.6-flash
# Dropbox App Folder integration (Phase A).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT=
DROPBOX_COOKIE_SECRET=
# Stream hub (services/stream-hub). Use the laptop's LAN IP so phones can reach it.
NEXT_PUBLIC_HUB_WS=ws://localhost:8787
